// Source of truth: .claude/skills/architecture — extend only via migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PayMethod {
  ONLINE
  WAFACASH
}

enum PayStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model User {
  id           String    @id @default(uuid())
  // Login identity (owner decision 2026-08-14): candidates sign in with their
  // PHONE + password. `username` is their display handle, free-form and often
  // written like an email ("salah@magueri") without being one.
  username     String?   @unique
  // Optional since registration stopped collecting it; existing accounts and
  // the seeded admin keep theirs, and the admin panel still signs in with it.
  email        String?   @unique
  phone        String?   @unique
  // No longer collected at registration; kept for accounts that have it.
  fullName     String?
  passwordHash String
  role         Role      @default(USER)
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  createdAt    DateTime  @default(now())
  payments      Payment[]
  attempts      Attempt[]
  devices       Device[]
  refreshTokens RefreshToken[]
}

// Refresh tokens stored hashed (sha256), rotated on every /auth/refresh.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  replacedBy String? // tokenHash of the successor token (rotation chain)
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Max 2 devices/user enforced in service layer.
model Device {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String
  pushToken  String?
  lastSeenAt DateTime
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
}

// Moroccan licence categories. B (car) is the default so every series that
// existed before this field keeps its meaning without a data migration.
enum LicenceCategory {
  B // سيارة
  A // دراجة نارية
  C // شاحنة
  D // حافلة
}

model Series {
  id        Int             @id @default(autoincrement())
  title     String
  orderNum  Int
  isPremium Boolean         @default(true)
  category  LicenceCategory @default(B)
  questions Question[]

  // Ordering is per category — each licence has its own "السلسلة 1، 2، 3…".
  @@index([category, orderNum])
}

model Question {
  id             Int      @id @default(autoincrement())
  seriesId       Int
  orderNum       Int
  answersCount   Int      @default(4)
  correctAnswers Json // e.g. [2,3]
  imageKey       String
  audioKey       String
  // Explanation of the right answer. Shown ONLY in the end-of-quiz review —
  // never while the quiz is running (owner decision, see quiz-engine skill).
  correctionText     String?
  correctionAudioKey String?
  updatedAt      DateTime @updatedAt
  series         Series   @relation(fields: [seriesId], references: [id])

  @@unique([seriesId, orderNum])
}

model LessonCategory {
  id        Int              @id @default(autoincrement())
  parentId  Int?
  title     String
  iconKey   String?
  orderNum  Int
  isPremium Boolean          @default(false)
  parent    LessonCategory?  @relation("Tree", fields: [parentId], references: [id])
  children  LessonCategory[] @relation("Tree")
  lessons   Lesson[]
}

model Lesson {
  id         Int            @id @default(autoincrement())
  categoryId Int
  title      String
  orderNum   Int
  // Cover shown on the lesson card in the app. Optional: a lesson is usable
  // without one, and the card falls back to its number.
  imageKey   String?
  kind       LessonKind     @default(SIGNS)
  updatedAt  DateTime       @updatedAt
  category   LessonCategory @relation(fields: [categoryId], references: [id])
  signs      LessonSign[]
  videos     LessonVideo[]
}

// A lesson is either a grid of sign flashcards or a list of videos. Explicit
// rather than inferred from content, so a freshly created empty lesson already
// knows which editor and which player it needs.
enum LessonKind {
  SIGNS
  VIDEOS
}

// Videos for a VIDEOS lesson (المركبة and the like). Unlike signs, these are
// STREAMED from storage with a signed url, never bundled into the offline
// sync — a handful of them would dwarf the whole rest of the content.
model LessonVideo {
  id        Int    @id @default(autoincrement())
  lessonId  Int
  orderNum  Int
  title     String
  videoKey  String
  // Recorded at upload so the admin can see what it is costing.
  sizeBytes Int?
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, orderNum])
}

// A SIGNS lesson is a grid of sign flashcards: image + Arabic name + audio
// explanation (owner decision, 2026-07-22; replaced the block/article model).
model LessonSign {
  id       Int     @id @default(autoincrement())
  lessonId Int
  orderNum Int
  name     String
  imageKey String
  audioKey String?
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// الشق التطبيقي — the practical (behind-the-wheel) part of the course: a flat
// list of videos, no categories or lessons above them. Kept separate from
// LessonVideo because it is a different product section, not a lesson: the app
// links to it straight from home and shows the videos themselves as cards.
// Same delivery rules as LessonVideo: uploaded mp4, STREAMED, never synced.
model PracticalVideo {
  id        Int      @id @default(autoincrement())
  orderNum  Int
  title     String
  videoKey  String
  // Optional poster shown on the card; falls back to a play icon.
  thumbKey  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([orderNum])
}

// Single row (id = 1). Cross-cutting app settings the owner edits from the
// panel. Currently the WhatsApp contact used to request access: the client
// dropped online payment in favour of "chat with us, then we add your number
// to the allowlist" (owner decision 2026-08-13).
model AppSettings {
  id              Int      @id @default(1)
  // Canonical local form (0XXXXXXXXX); converted to +212… for the wa.me link.
  whatsappNumber  String?
  // Optional prefix for the prefilled message; the app appends the candidate's
  // own name and number so the admin knows exactly who to add.
  whatsappMessage String?
  updatedAt       DateTime @updatedAt
}

// Allowlist of phone numbers that get premium WITHOUT paying (a partner
// driving school's group, etc). Server-side only: the client never asserts
// membership, it just registers with its phone number and the API decides —
// so the "premium only from a verified source" rule still holds, with the
// admin's audited allowlist as the second such source alongside the webhook.
model PremiumPhone {
  id        String    @id @default(uuid())
  // Canonical local form (0XXXXXXXXX) so +212 / 00212 / 0… all match.
  phone     String    @unique
  note      String? // e.g. the school or group name
  addedById String
  // Set when a registration (or a later admin add) actually granted premium.
  claimedAt DateTime?
  claimedBy String? // user id
  createdAt DateTime  @default(now())

  @@index([claimedAt])
}

model Payment {
  id           String    @id @default(uuid())
  userId       String
  method       PayMethod
  amount       Decimal
  currency     String    @default("MAD")
  status       PayStatus @default(PENDING)
  wafacashCode String?   @unique
  payzoneRef   String?
  paidAt       DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])
}

model Attempt {
  id          String   @id @default(uuid())
  userId      String
  seriesId    Int
  score       Int
  total       Int      @default(40)
  passed      Boolean
  detailsJson Json
  finishedAt  DateTime
  user        User     @relation(fields: [userId], references: [id])
}

// Every admin action that changes money/premium state is recorded here.
model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String // mark_paid | grant_premium | revoke_premium
  targetType String // payment | user
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

// Webhook idempotency + payload log. Same (provider,eventId) twice = one effect.
model WebhookEvent {
  id        String   @id @default(uuid())
  provider  String
  eventId   String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

model ContentVersion {
  id        Int      @id @default(1)
  version   Int
  updatedAt DateTime @updatedAt
}

// Single row (id = 1). The owner streams every day at the same wall-clock time
// on the same four profiles, so there is no per-event data to keep — only where
// the live happens and when. A typed singleton beats a key/value settings table
// here because Prisma then validates the shape for us.
model LiveSettings {
  id           Int     @id @default(1)
  youtubeUrl   String?
  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  // Daily start, "HH:mm" in Africa/Casablanca — deliberately local wall-clock,
  // not UTC: 23:00 stays 23:00 for viewers regardless of any offset change.
  startTime    String  @default("23:00")
  enabled      Boolean @default(true)
  // Casablanca date (YYYY-MM-DD) each push last went out. Makes the every-minute
  // cron idempotent for a *recurring* live without storing a row per occurrence.
  lastReminderOn String?
  lastStartOn    String?
  lastPushReach  Int      @default(0) // devices the last push reached
  updatedAt      DateTime @updatedAt
}
