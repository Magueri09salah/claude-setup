# ─────────────────────────────────────────────────────────────────────────────
# API — production environment (Hostinger VPS, single origin)
#
# Copy to /var/www/codeboujida/api/.env on the server and fill every <…> value.
# NEVER commit the filled-in file. After editing: pm2 reload ecosystem.config.js
# ─────────────────────────────────────────────────────────────────────────────

# Must be exactly "production": it binds the API to localhost only, blocks the
# mock payment gateway from mounting, and requires APP_BASE_URL below.
NODE_ENV=production

# Port nginx proxies to. Change only if 4000 is already taken — nginx must match.
PORT=4000
# Interface to bind. Leave 127.0.0.1: the API must be reachable ONLY through
# nginx. Setting 0.0.0.0 would expose port 4000 to the internet in plain HTTP.
HOST=127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# Local PostgreSQL, limited-privilege user (NOT postgres). Password must be
# URL-encoded if it contains @ : / ? # or &.
DATABASE_URL=postgresql://codeboujida_app:<DB_PASSWORD>@127.0.0.1:5432/codeboujida?schema=public
# Prisma requires this for every CLI command (migrate/generate). There is no
# connection pooler on a single VPS, so use the SAME value as DATABASE_URL.
# Leaving it empty makes `prisma migrate deploy` fail with P1012.
DIRECT_DATABASE_URL=postgresql://codeboujida_app:<DB_PASSWORD>@127.0.0.1:5432/codeboujida?schema=public

# ── Secrets — min 32 characters each ─────────────────────────────────────────
# Generate a fresh value for EACH line with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the values from your laptop's .env.
JWT_ACCESS_SECRET=<32+ RANDOM CHARS>
JWT_REFRESH_SECRET=<32+ RANDOM CHARS — different from the one above>
MEDIA_SIGNING_SECRET=<32+ RANDOM CHARS — different again>

# ── Public addresses ─────────────────────────────────────────────────────────
# The API's public origin INCLUDING the /api path prefix. Absolute media links
# are built from it, so without the /api part phones get dead links.
# The API refuses to start in production if this is missing.
APP_BASE_URL=https://codeboujida.com/api

# Browser origins allowed to call the API, comma-separated.
# LEAVE EMPTY: the admin panel is served from the same domain (/admin), so it
# needs no cross-origin permission at all. Fill this only if the panel ever
# moves to its own hostname. The mobile app is native and unaffected.
CORS_ORIGINS=

# ── Media storage (Cloudflare R2) — REQUIRED ─────────────────────────────────
# Every question image, audio file and video lives here. All four values are
# mandatory in production: the API REFUSES TO START if they are missing, and
# refuses if only some are filled in (a typo in one used to downgrade storage to
# the server disk silently, where the media is lost with the machine).
#
# Where to find them: Cloudflare dashboard -> R2
#   1. Create a bucket, note its name              -> R2_BUCKET
#   2. Account ID is shown in the R2 sidebar       -> R2_ACCOUNT_ID
#   3. Manage API Tokens -> Create API token
#      with "Object Read & Write" on that bucket   -> the other two values
#
# After deploying, the startup log must say "storage: r2".
R2_ACCOUNT_ID=<CLOUDFLARE ACCOUNT ID>
R2_ACCESS_KEY_ID=<R2 ACCESS KEY ID>
R2_SECRET_ACCESS_KEY=<R2 SECRET ACCESS KEY>
R2_BUCKET=<BUCKET NAME>

# Deliberate override to store media on the VPS disk instead of R2. Leave empty.
# Only set it to "true" if you consciously accept that media then lives on this
# machine alone and is only as safe as the backup mirror.
ALLOW_LOCAL_STORAGE=

# ── Payments — OFF ───────────────────────────────────────────────────────────
# Access is arranged over WhatsApp and granted from the admin allowlist, so the
# payment routes have no caller. Leave false: enabling them without a real
# gateway lets any registered user settle their own payment for free.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=mock
# Required ONLY if PAYMENTS_ENABLED=true with a mock provider (dev only).
MOCK_WEBHOOK_SECRET=

# Placeholder pricing, unused while payments are off.
PRICE_AMOUNT=99
PRICE_CURRENCY=MAD
PRICE_DURATION_DAYS=0

# ── Seeding (first deploy only) ──────────────────────────────────────────────
# Used once by `npx prisma db seed` to create the first admin account.
# The seed REFUSES to run without a password — that is deliberate: the old
# fallback ("Admin123!") is published in this repository.
SEED_ADMIN_EMAIL=<YOUR ADMIN EMAIL>
SEED_ADMIN_PASSWORD=<A STRONG PASSWORD YOU CHOOSE>
# Placeholder series/questions for local development. MUST stay false here:
# the demo rows bump the content version and sync to every installed phone.
SEED_DEMO_CONTENT=false
