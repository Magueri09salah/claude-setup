# Server
PORT=4000
# Optional: base URL used in signed local-media URLs (set to your LAN IP to test from a phone)
# APP_BASE_URL=http://192.168.1.10:4000

# PostgreSQL — pooled URL for runtime, direct (non-pooler) URL for migrations.
# On Neon: DIRECT_DATABASE_URL is the same URL without the "-pooler" host suffix.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth secrets — generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-min-32-random-bytes
JWT_REFRESH_SECRET=change-me-min-32-random-bytes

# Local-media URL signing (used by the local disk fallback when R2 is not configured)
MEDIA_SIGNING_SECRET=change-me-min-32-random-bytes

# Cloudflare R2 — leave all four empty to use local disk storage under api/uploads (dev only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Node environment. Set to "production" on a real server: it blocks the mock
# payment gateway from ever being mounted.
NODE_ENV=development

# Payments. OFF unless this is exactly "true" — the app arranges access over
# WhatsApp and the admin allowlist grants it, so nothing calls these routes.
# While they were mounted, any registered user could settle their own payment
# and take a free subscription. Turn on only when a real gateway is wired up.
PAYMENTS_ENABLED=false
# PAYMENT_PROVIDER=mock uses a fake local payment page (never in production);
# switch to payzone when the merchant docs arrive.
PAYMENT_PROVIDER=mock
# Required ONLY when PAYMENTS_ENABLED=true with the mock provider. No default:
# a secret committed to the repo is not a secret.
MOCK_WEBHOOK_SECRET=
PRICE_AMOUNT=99
PRICE_CURRENCY=MAD
# Access duration in days; 0 = lifetime.
PRICE_DURATION_DAYS=0

# Push notifications (Expo) need no API key for the basic flow — the Expo push
# service accepts ExponentPushToken values directly. The cron runs in-process
# every minute (lives T-15/T-0 reminders + expiring stale Wafacash codes).

# Seed script. SEED_ADMIN_PASSWORD is REQUIRED (min 8) — the seed refuses to run
# without it rather than falling back to a password published in this repo.
SEED_ADMIN_EMAIL=admin@driving.local
SEED_ADMIN_PASSWORD=
# Placeholder series/questions/signs for local work. Leave false on a real
# server: the demo rows bump contentVersion and sync to every installed phone.
SEED_DEMO_CONTENT=false
