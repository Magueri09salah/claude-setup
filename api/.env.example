# Server
PORT=4000

# PostgreSQL — needed for prisma migrate/generate and (from M1) runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/driving_app

# JWT (used from M1) — generate real secrets, never commit them
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Cloudflare R2 (used from M1)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
