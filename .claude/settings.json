{
  "permissions": {
    "allow": [
      "PowerShell($env:CI='1'; npx --yes create-expo-app@latest mobile --template default)",
      "PowerShell(Copy-Item api\\\\.env.example api\\\\.env)",
      "PowerShell(npm --prefix api install)",
      "PowerShell(npm --prefix admin install)",
      "PowerShell(npm --prefix api run typecheck)",
      "PowerShell(node -e \"const p=require\\('./api/package.json'\\); console.log\\(Object.keys\\(p.dependencies\\)\\); console.log\\(Object.keys\\(p.devDependencies\\)\\)\")",
      "PowerShell(node -e \"const p=require\\('./package.json'\\); console.log\\(JSON.stringify\\(p.dependencies||{},null,1\\)\\); console.log\\(JSON.stringify\\(p.devDependencies||{},null,1\\)\\)\")",
      "PowerShell(npm run typecheck)",
      "PowerShell($conns = Get-NetTCPConnection -LocalPort 4000 -State Listen -ErrorAction SilentlyContinue; if \\($conns\\) { $conns | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -Confirm:$false }; \"dev server stopped\" } else { \"nothing listening on 4000\" })",
      "PowerShell(git add -A)"
    ]
  }
}
